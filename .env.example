# ============================================================
# Second Brain — Environment Variables Reference
# ============================================================
# Copy this file to .env and fill in your values.
# All variables are prefixed with SECOND_BRAIN_
# ============================================================

# ── Database ─────────────────────────────────────────────────
# Use "local" for SQLite (zero-config dev) or "postgres" for Docker/production
SECOND_BRAIN_DATABASE_MODE=local

# If DATABASE_MODE=postgres, set a full connection URL:
# SECOND_BRAIN_DATABASE_URL=postgresql+psycopg://second_brain:CHANGE_ME@postgres:5432/second_brain

# Individual Postgres params (used when DATABASE_URL is not set):
SECOND_BRAIN_POSTGRES_HOST=127.0.0.1
SECOND_BRAIN_POSTGRES_PORT=5432
SECOND_BRAIN_POSTGRES_DB=second_brain
SECOND_BRAIN_POSTGRES_USER=second_brain
SECOND_BRAIN_POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION

# ── API Server ───────────────────────────────────────────────
SECOND_BRAIN_API_HOST=127.0.0.1
SECOND_BRAIN_API_PORT=8000

# Remote access (set true only when behind a reverse proxy with auth)
SECOND_BRAIN_ALLOW_REMOTE_CLIENTS=false

# Optional: require X-API-Key header on all /api/* routes
# SECOND_BRAIN_API_KEY=your-secure-random-key-here

# ── Authentication ───────────────────────────────────────────
# localhost = no auth (single-user local); multi_user = JWT cookie auth
SECOND_BRAIN_AUTH_MODE=localhost

# ⚠️  MUST be changed in production! Generate with: openssl rand -hex 32
SECOND_BRAIN_AUTH_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_openssl_rand_hex_32

SECOND_BRAIN_AUTH_ACCESS_TOKEN_MINUTES=30
SECOND_BRAIN_AUTH_REFRESH_TOKEN_DAYS=7
# Set true when serving over HTTPS
SECOND_BRAIN_AUTH_COOKIE_SECURE=false

# ── LLM / AI ─────────────────────────────────────────────────
SECOND_BRAIN_LLM_PROVIDER=ollama
SECOND_BRAIN_LLM_MODEL=qwen2.5:0.5b
SECOND_BRAIN_EMBEDDING_MODEL=nomic-embed-text
SECOND_BRAIN_OLLAMA_BASE_URL=http://localhost:11434

# Optional: cloud provider keys (opt-in, never required for local use)
# SECOND_BRAIN_OPENAI_API_KEY=sk-...
# SECOND_BRAIN_ANTHROPIC_API_KEY=sk-ant-...
# SECOND_BRAIN_GOOGLE_API_KEY=...
# SECOND_BRAIN_OPENROUTER_API_KEY=...
# SECOND_BRAIN_GROQ_API_KEY=...

# ── Storage ──────────────────────────────────────────────────
# Override data directories (defaults to <project>/data/)
# SECOND_BRAIN_APP_DATA_DIR=/var/lib/second-brain
# SECOND_BRAIN_CHROMA_PERSIST_DIR=/var/lib/second-brain/chroma
# SECOND_BRAIN_UPLOAD_DIR=/var/lib/second-brain/uploads

# Max file upload size in MB
SECOND_BRAIN_MAX_UPLOAD_SIZE_MB=25

# ── Redis / Celery ───────────────────────────────────────────
SECOND_BRAIN_REDIS_URL=redis://127.0.0.1:6379/0
# Celery broker/backend default to REDIS_URL; override if needed:
# SECOND_BRAIN_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# SECOND_BRAIN_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Enable/disable background job processing (Celery workers)
SECOND_BRAIN_BACKGROUND_JOBS_ENABLED=true

# ── Rate Limits ──────────────────────────────────────────────
SECOND_BRAIN_RATE_LIMIT_AI_PER_MINUTE=30
SECOND_BRAIN_RATE_LIMIT_INGEST_PER_MINUTE=20
SECOND_BRAIN_RATE_LIMIT_AUTH_PER_MINUTE=20

# ── Resource / Performance ───────────────────────────────────
SECOND_BRAIN_LOW_RESOURCE_MODE=false
SECOND_BRAIN_MODEL_RAM_TIER=8gb
SECOND_BRAIN_MAX_AI_CONCURRENCY=2
SECOND_BRAIN_AI_CONTEXT_WINDOW=4096
SECOND_BRAIN_CPU_THROTTLE_PERCENT=80
SECOND_BRAIN_MEMORY_BUDGET_MB=1536
SECOND_BRAIN_BATTERY_SAVER_MODE=false
SECOND_BRAIN_REDUCED_ANIMATIONS=false
SECOND_BRAIN_RESOURCE_MONITOR_ENABLED=true
SECOND_BRAIN_RESOURCE_MONITOR_CORNER=bottom-right

# ── Tauri Desktop Sidecar ────────────────────────────────────
# Set automatically by the Tauri shell; do not set manually.
# SECOND_BRAIN_SIDECAR_MODE=false

