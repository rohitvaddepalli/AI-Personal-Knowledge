FROM node:20-alpine

WORKDIR /app

# Install deps first (cached layer)
COPY package*.json ./
RUN npm ci --legacy-peer-deps

# Source is mounted as volume at runtime — no COPY needed
EXPOSE 5173

# Bind to all interfaces so Docker port-forwarding works
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

